{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1920\">\n<title>Story maandag</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n\n<div class=\"dots\" style=\"width: 1080px; height: 1920px; box-sizing: border-box; background-color: #FFF8F0; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; padding: 270px 80px 360px; gap: 46px; font-family: 'DM Sans', sans-serif; color: #1A1A1A; text-align: center\">\n<div style=\"font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 66px; color: #E3404B\" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"30\">nieuw in onze feed</div>\n<div style=\"font-family: 'Lilita One', sans-serif; line-height: 0.98; font-size: 112px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"34\">De trein naar Oekraïne</div>\n<div style=\"width: 700px; height: 900px; position: relative; overflow: hidden; border: 6px solid #1A1A1A; border-radius: 22px; box-shadow: 14px 14px 0 #FF7033; background: #FFF; transform: rotate(2deg); flex: none; \"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/src/assets/comic/strip-10.webp\" alt=\"Strippaneel: Akke en Nastya komen doorweekt binnen in de motelkamer\" style=\"position: absolute; width: 1646.2px; left: -858.0px; top: -128.7px; max-width: none; display: block\"></div>\n<div style=\"font-size: 42px; font-weight: 600\" data-slot=\"onderregel\" data-label=\"Onderregel\" data-max=\"50\">Zes panelen, één natte avond. Kijk in de feed.</div>\n</div>\n</body>\n</html>\n"}