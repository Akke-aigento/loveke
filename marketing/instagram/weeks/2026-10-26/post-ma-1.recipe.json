{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Carousel 1: haak</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n<div class=\"dots\" style=\"width: 1080px; height: 1350px; box-sizing: border-box; background-color: #FFF8F0; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; padding: 80px; gap: 44px; font-family: 'DM Sans', sans-serif; color: #1A1A1A\"><div style=\"position: absolute; top: 56px; right: 64px; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 26px; color: #1A1A1A; background: #FFD43D; border: 4px solid #1A1A1A; border-radius: 40px; padding: 6px 18px\">1/6</div>\n<div style=\"font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 54px; color: #E3404B; \" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"34\">uit onze strip, paneel per paneel</div>\n<div style=\"display: flex; flex-direction: column; gap: 10px\">\n<div style=\"font-family: 'Lilita One', sans-serif; line-height: 0.98; font-size: 82px\" data-slot=\"regel1\" data-label=\"Regel 1\" data-max=\"30\">Vertrokken in de zon.</div>\n<div style=\"font-family: 'Lilita One', sans-serif; line-height: 0.98; font-size: 82px; color: #FF7033\" data-slot=\"regel2\" data-label=\"Regel 2\" data-max=\"30\">Aangekomen in de regen.</div>\n</div>\n<div style=\"width: 910px; height: 420px; position: relative; overflow: hidden; border: 6px solid #1A1A1A; border-radius: 22px; box-shadow: 14px 14px 0 #FF7033; background: #FFF; transform: rotate(-2deg); flex: none; \"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/src/assets/comic/strip-9.webp\" alt=\"Strippaneel: Akke en Nastya lachen samen aan een tafeltje in de trein\" style=\"position: absolute; width: 1120.0px; left: -104.4px; top: -83.8px; max-width: none; display: block\"></div>\n<div style=\"position: absolute; right: 80px; bottom: 60px; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 60px; color: #1A1A1A; transform: rotate(-4deg)\" data-slot=\"swipe\" data-label=\"Swipe\" data-max=\"14\">swipe →</div>\n</div>\n</body>\n</html>\n"}