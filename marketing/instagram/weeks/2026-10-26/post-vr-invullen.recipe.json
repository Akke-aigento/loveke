{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Vul aan</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n\n<div style=\"width: 1080px; height: 1350px; box-sizing: border-box; background: #FFD43D; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; padding: 90px; gap: 30px; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div style=\"font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 70px; color: #E3404B; transform: rotate(-3deg); align-self: flex-start\" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"24\">vul aan, eerlijk zijn</div>\n<div style=\"font-family: 'Lilita One', sans-serif; line-height: 0.98; font-size: 150px; line-height: 0.95\" data-slot=\"zin\" data-label=\"Zin\" data-max=\"30\">Mijn Loveke steelt altijd</div>\n<div style=\"height: 26px; width: 760px; background: #1A1A1A; border-radius: 14px; margin-top: 40px; box-shadow: 10px 10px 0 #FF7033\"></div>\n<div style=\"font-size: 38px; font-weight: 600; margin-top: 60px\" data-slot=\"onderregel\" data-label=\"Onderregel\" data-max=\"44\">Antwoord in de reacties. Wij lezen alles.</div>\n<div class=\"wm\" style=\"position: absolute; right: 80px; bottom: 70px; font-family: 'Lilita One', sans-serif; line-height: 0.98; font-size: 70px\">Loveke</div>\n</div>\n</body>\n</html>\n"}