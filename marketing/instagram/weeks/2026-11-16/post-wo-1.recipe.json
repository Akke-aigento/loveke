{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Warsaw deel 2</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n<div class=\"dots\" style=\"width: 1080px; height: 1350px; box-sizing: border-box; background-color: #FFF8F0; position: relative; overflow: hidden; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div style=\"position: absolute; top: 40px; right: 48px; font-weight: 700; font-size: 26px; background: #FFD43D; border: 4px solid #1A1A1A; border-radius: 40px; padding: 6px 18px; z-index: 5\">1/8</div>\n<div style=\"position: absolute; left: 70px; top: 110px; font-family: 'Caveat', cursive; font-weight: 700; font-size: 64px; color: #E3404B; transform: rotate(-3deg)\" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"30\">hier waren we gebleven</div>\n<div style=\"position: absolute; left: 70px; right: 70px; top: 190px; font-family: 'Lilita One', sans-serif; line-height: 0.92; font-size: 190px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"16\" data-multiline=\"true\">Warsaw</div>\n<div style=\"position: absolute; left: 74px; top: 390px; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 44px\" data-slot=\"subtitel\" data-label=\"Subtitel\" data-max=\"40\">deel 2 van 2 · drie dagen samen</div>\n<div style=\"position: absolute; left: 70px; top: 560px; width: 470px; height: 630px; border: 6px solid #1A1A1A; border-radius: 18px; overflow: hidden; background:#FFF; box-shadow: 14px 14px 0 #FFD43D; transform: rotate(-4deg)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/comic-2/warsaw-p08.jpg\" alt=\"Strip Warsaw, pagina 8\" style=\"width: 100%; height: 100%; display: block; object-fit: cover\"></div>\n<div style=\"position: absolute; left: 540px; top: 520px; width: 470px; height: 630px; border: 6px solid #1A1A1A; border-radius: 18px; overflow: hidden; background:#FFF; box-shadow: 14px 14px 0 #FF7033; transform: rotate(5deg)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/comic-2/warsaw-p11.jpg\" alt=\"Strip Warsaw, pagina 11\" style=\"width: 100%; height: 100%