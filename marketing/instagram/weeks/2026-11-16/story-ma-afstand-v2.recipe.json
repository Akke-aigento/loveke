{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1920\">\n<title>Story lange afstand poll</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n\n<div style=\"width: 1080px; height: 1920px; box-sizing: border-box; background: #FFF8F0; position: relative; overflow: hidden; font-family: 'DM Sans', sans-serif; color: #1A1A1A; text-align: center\">\n<div class=\"dots\" style=\"position: absolute; inset: 0; opacity: .6\"></div>\n<div style=\"position: absolute; left: 0; right: 0; top: 0; height: 22px; background: #E3404B\"></div>\n<div style=\"position: absolute; left: 70px; right: 70px; top: 270px; font-family: 'Lilita One', sans-serif; font-size: 120px; line-height: .95; color: #E3404B\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"20\">Lange afstand:</div>\n<div style=\"position: absolute; left: 70px; right: 70px; top: 395px; font-family: 'Lilita One', sans-serif; font-size: 120px; line-height: .95\" data-slot=\"vraag\" data-label=\"Vraag\" data-max=\"28\">zou jij het doen?</div>\n<div style=\"position: absolute; left: 90px; top: 600px; width: 900px; border: 7px solid #1A1A1A; border-radius: 26px; box-shadow: 14px 14px 0 #1A1A1A; overflow: hidden; background: #FFF; transform: rotate(-2deg)\">\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/weeks/2026-11-16/img/warsaw-phones-kyiv.jpg\" alt=\"Stripbeeld: telefoons met berichtjes en hartjes, de klok van Kyiv\" style=\"width: 100%; display: block\">\n</div>\n<div style=\"position: absolute; left: 120px; right: 120px; top: 1215px; font-family: 'Caveat', cursive; font-weight: 700; font-size: 68px; line-height: 1.05; transform: rotate(-1.5deg)\" data-slot=\"onderregel\" data-label=\"Onderregel\" data-max=\"40\">wij deden het: Kyiv – Leuven</div>\n<div class=\"slot\" style=\"position: absolute; left: 190px; right: 190px; top: 1360px; height: 300px; border-radius: 30px; background: #FFF\">poll</div>\n</div>\n</body>\n</html>\n"}