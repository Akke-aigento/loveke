{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Hoodie 280</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n\n<div style=\"width: 1080px; height: 1350px; box-sizing: border-box; background: #FFD43D; position: relative; overflow: hidden; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div class=\"dots\" style=\"position: absolute; inset: 0; opacity: .6\"></div>\n<div style=\"position: absolute; left: 60px; top: 40px; font-family: 'Lilita One', sans-serif; line-height: 0.85; font-size: 400px; color: #FFF8F0; -webkit-text-stroke: 8px #1A1A1A; text-shadow: 14px 14px 0 #1A1A1A\" data-slot=\"cijfer\" data-label=\"Groot cijfer\" data-max=\"4\">280</div>\n<div style=\"position: absolute; left: 70px; top: 400px; font-family: 'Lilita One', sans-serif; font-size: 58px; line-height: 1\" data-slot=\"eenheid\" data-label=\"Eenheid\" data-max=\"24\">gram per m²</div>\n<div style=\"position: absolute; right: 50px; top: 70px; width: 330px; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 54px; transform: rotate(4deg); text-align: right\" data-slot=\"handregel\" data-label=\"Handgeschreven\" data-max=\"36\" data-multiline=\"true\">zo zwaar is onze fleece</div>\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/hoodie-1.png\" alt=\"Zwarte Loveke Classic Hoodie met het Loveke-logo\" style=\"position: absolute; left: 360px; top: 450px; width: 700px; display: block; transform: rotate(3deg); filter: drop-shadow(14px 14px 0 #FF7033)\">\n<div style=\"position: absolute; left: 70px; top: 560px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px\">\n<div style=\"white-space: nowrap; font-size: 30px; font-weight: 700; background: #FFF8F0; border: 4px solid #1A1A1A; border-radius: 40px; padding: 10px 20px; transform: rotate(-3deg)\" data-slot=\"feit1\" data-label=\"Feit 1\" data-max=\"24\">80% bio-katoen</div>\n<div style=\"white-space: nowrap; font-size: 30px; font-weight: 700; background: #FFF8F0; border: 4px solid #1A1A1A; border-radius: 40px; padding: 10px 20px; transform: rotate(2deg)\" data-slot=\"feit2\" data-label=\"Feit 2\" data-max=\"26\">20% gerecycleerd polyester</div>\n<div style=\"white-space: nowrap; font-size: 30px; font-weight: 700; background: #FFF8F0; border: 4px solid #1A1A1A; border-radius: 40px; padding: 10px 20px; transform: rotate(-2deg)\" data-slot=\"feit3\" data-label=\"Feit 3\" data-max=\"24\">geborsteld vanbinnen</div>\n</div>\n<div style=\"position: absolute; left: 70px; right: 70px; bottom: 60px; display: flex; justify-content: space-between; align-items: flex-end\">\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 78px; line-height: 0.95\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"22\">Classic Hoodie</div>\n<div style=\"background: #E3404B; color: #FFF8F0; border: 6px solid #1A1A1A; border-radius: 26px; box-shadow: 10px 10px 0 #1A1A1A; padding: 14px 26px; transform: rotate(-4deg); font-family: 'Lilita One', sans-serif; font-size: 64px\" data-slot=\"prijs\" data-label=\"Prijs\" data-max=\"8\">€59,95</div>\n</div>\n</div>\n</body>\n</html>\n"}