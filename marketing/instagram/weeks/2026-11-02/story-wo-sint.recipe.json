{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1920\">\n<title>Story woensdag Sint</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n\n<div style=\"width: 1080px; height: 1920px; box-sizing: border-box; background: #E3404B; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; padding: 270px 80px 360px; gap: 38px; font-family: 'DM Sans', sans-serif; color: #FFF8F0; text-align: center\">\n<div class=\"dots\" style=\"position: absolute; inset: 0; opacity: .5\"></div>\n<div style=\"position: relative; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 66px; color: #FFD43D\" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"30\">nog 32 nachtjes slapen</div>\n<div style=\"position: relative; font-family: 'Lilita One', sans-serif; line-height: 0.95; font-size: 124px; -webkit-text-stroke: 4px #1A1A1A\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"30\">Al iets op je Sint-lijstje?</div>\n<div style=\"position: relative; display: flex; gap: 10px; justify-content: center; height: 600px; flex: none\">\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/tee-4.png\" alt=\"Vrouw in de zwarte Loveke Classic Oversized Tee\" style=\"height: 600px; display: block; transform: rotate(-4deg); filter: drop-shadow(12px 12px 0 #1A1A1A)\">\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/hoodie-3.png\" alt=\"Vrouw in de zwarte Loveke Classic Hoodie\" style=\"height: 600px; display: block; transform: rotate(3deg); filter: drop-shadow(12px 12px 0 #1A1A1A)\">\n</div>\n<div style=\"position: relative; font-size: 40px; font-weight: 700; background: #FFF8F0; color: #1A1A1A; border: 5px solid #1A1A1A; border-radius: 30px; padding: 16px 28px; box-shadow: 8px 8px 0 #1A1A1A\" data-slot=\"info\" data-label=\"Info\" data-max=\"56\" data-multiline=\"true\">Gemaakt op bestelling: 5 tot 20 werkdagen</div>\n<div class=\"slot\" style=\"width: 560px; height: 150px; border-radius: 30px; background: #FFF\">link</div>\n</div>\n</body>\n</html>\n"}