>\n<body>\n\n<div class=\"dots\" style=\"width: 1080px; height: 1350px; box-sizing: border-box; background-color: #FF7033; position: relative; overflow: hidden; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div style=\"position: absolute; top: 56px; right: 64px; font-weight: 700; font-size: 26px; background: #FFD43D; border: 4px solid #1A1A1A; border-radius: 40px; padding: 6px 18px; z-index: 5\">5/6</div>\n<div style=\"position: absolute; left: 70px; top: 130px; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 66px; color: #FFF8F0; transform: rotate(-3deg)\" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"30\">liever iets luider?</div>\n<div style=\"position: absolute; left: 70px; top: 220px; font-family: 'Lilita One', sans-serif; line-height: 0.95; font-size: 130px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"16\">Classic Hat</div>\n<div style=\"position: absolute; left: 70px; top: 400px; width: 560px; height: 820px; overflow: hidden; border: 6px solid #1A1A1A; border-radius: 26px; box-shadow: 14px 14px 0 #1A1A1A; background: #FFF; transform: rotate(2deg)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/classic-hat-2.png\" alt=\"Man met de zwarte Loveke Classic Hat met het oranje Loveke-logo\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block\"></div>\n<div style=\"position: absolute; left: 600px; top: 520px; width: 420px; height: 420px; overflow: hidden; border: 6px solid #1A1A1A; border-radius: 26px; box-shadow: 14px 14px 0 #FFD43D; background: #FFF; transform: rotate(-4deg)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/classic-hat-1.png\" alt=\"Zwarte Loveke Classic Hat met het Loveke-logo\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: center; display: block\"></div>\n<div style=\"position: absolute; left: 660px; top: 1050px; background: #FFF8F0; color: #1A1A1A; border: 6px solid #1A1A1A; border-radius: 26px; box-shadow: 10px 10px 0 #1A1A1A; padding: 12px 26px; transform: rotate(4deg); font-family: 'Lilita One', sans-serif; line-height: 0.95; font-size: 66px\" data-slot=\"prijs\" data-label=\"Prijs\" data-max=\"12\">€29,95</div>\n</div>\n</body>\n</html>\n"}