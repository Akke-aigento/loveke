{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Nieuw: Loveke Sweet</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n</head>\n<body>\n\n<div class=\"dots\" style=\"width: 1080px; height: 1350px; box-sizing: border-box; background-color: #FFF8F0; position: relative; overflow: hidden; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div style=\"position: absolute; top: 56px; right: 64px; font-weight: 700; font-size: 26px; background: #FFD43D; border: 4px solid #1A1A1A; border-radius: 40px; padding: 6px 18px; z-index: 5\">1/6</div>\n<div style=\"position: absolute; left: 70px; top: 120px; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 64px; color: #E3404B; transform: rotate(-3deg)\" data-slot=\"bovenregel\" data-label=\"Bovenregel\" data-max=\"30\">net binnen in de shop</div>\n<div style=\"position: absolute; left: 70px; right: 70px; top: 210px; font-family: 'Lilita One', sans-serif; line-height: 0.95; font-size: 160px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"24\" data-multiline=\"true\">Nieuw: Loveke Sweet</div>\n<div style=\"position: absolute; left: 70px; top: 540px; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 60px\" data-slot=\"subtitel\" data-label=\"Subtitel\" data-max=\"40\">zelfde liefde, kleiner geschreven</div>\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/sweet-tee-1.png\" alt=\"Witte Loveke Sweet Tee met klein loveke-schrift op de borst\" style=\"position: absolute; left: 20px; top: 640px; width: 560px; transform: rotate(-5deg); filter: drop-shadow(12px 12px 0 #FF85A1)\">\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/sweet-pet-1.png\" alt=\"Zwarte Loveke Sweet Hat met loveke-schrift op de zijkant\" style=\"position: absolute; left: 520px; top: 600px; width: 520px; transform: rotate(6deg); filter: drop-shadow(12px 12px 0 #FFD43D)\">\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/sweet-cup-1.png\" alt=\"Witte Loveke Sweet Cup met loveke-schrift\" style=\"position: absolute; left: 560px; top: 900px; width: 420px; transform: rotate(-4deg); filter: drop-shadow(12px 12px 0 #FF7033)\">\n<div style=\"position: absolute; right: 70px; bottom: 50px; font-family: 'Caveat', cursive; font-weight: 700; line-height: 1.05; font-size: 60px\">swipe &rarr;</div>\n</div>\n</body>\n</html>\n"}