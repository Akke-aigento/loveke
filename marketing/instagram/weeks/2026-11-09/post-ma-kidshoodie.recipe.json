 960px; width: 360px; background: #FFF8F0; border: 6px solid #1A1A1A; border-radius: 24px; box-shadow: 10px 10px 0 #1A1A1A; padding: 20px 24px; transform: rotate(3deg)\">\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 42px; line-height: 1\" data-slot=\"product\" data-label=\"Product\" data-max=\"26\">Classic Hoodie Kids</div>\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 64px; line-height: 1.05; color: #E3404B\" data-slot=\"prijs\" data-label=\"Prijs\" data-max=\"10\">€49,95</div>\n<div style=\"font-weight: 700; font-size: 30px\" data-slot=\"maten\" data-label=\"Maten\" data-max=\"24\">van 4 tot 12 jaar</div>\n</div>\n<div style=\"position: absolute; right: 60px; bottom: 44px; font-family: 'Lilita One', sans-serif; font-size: 58px; background: #1A1A1A; color: #FFF8F0; padding: 4px 22px; border-radius: 16px\">Loveke</div>\n</div>\n</body>\n</html>\n"}