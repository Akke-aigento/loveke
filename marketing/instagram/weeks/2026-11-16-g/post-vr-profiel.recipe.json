{"version":1,"width":1080,"height":1350,"html":"<!doctype html><html lang=\"nl\"><head><meta charset=\"utf-8\"><meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Datingprofiel Sweet Cup</title><style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n<!-- genre: profiel (I). Feiten live (16-11): Loveke Sweet Cup €24,95; omschrijving uit de weekpost (wit, zilveren rand, \"loveke\" in handschrift); op bestelling, gratis verzending, Loveke for Two 7% vanaf 2 stuks. -->\n<style>\nbody{background:var(--pink);font-family:'DM Sans'}\n.bg{position:absolute;inset:0}\n.card{position:absolute;left:150px;top:70px;width:780px;height:1110px;background:#fff;border:6px solid var(--black);border-radius:46px;box-shadow:16px 16px 0 var(--black);overflow:hidden;transform:rotate(-2deg)}\n.ph{height:560px;background:var(--cream);position:relative;border-bottom:6px solid var(--black)}\n.ph img{position:absolute;left:50%;top:50%;width:470px;transform:translate(-50%,-48%)}\n.badge{position:absolute;left:30px;top:30px;background:var(--yellow);border:4px solid var(--black);border-radius:99px;padding:8px 22px;font:700 24px 'DM Sans'}\n.in{padding:34px 44px}\nh1{font:400 70px/1 'Lilita One';margin:0;color:var(--black)}\nh1 span{font-size:44px;color:#777}\n.loc{font:600 26px 'DM Sans';color:#666;margin:8px 0 22px}\n.tags{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px}\n.tags b{border:3px solid var(--black);border-radius:99px;padding:6px 18px;font:700 24px 'DM Sans';background:var(--cream)}\n.q{font:700 26px 'DM Sans';color:#999;text-transform:uppercase;letter-spacing:.08em}\n.a{font:600 34px/1.3 'DM Sans';color:var(--black);margin:6px 0 0}\n.btns{position:absolute;left:0;right:0;bottom:60px;display:flex;justify-content:center;gap:90px}\n.btns div{width:130px;height:130px;border-radius:50%;border:6px solid var(--black);background:#fff;box-shadow:8px 8px 0 var(--black);display:grid;place-items:center}\n.x::before,.x::after{content:\"\";position:absolute;width:60px;height:12px;background:#999;border-radius:6px;transform:rotate(45deg)}.x::after{transform:rotate(-45deg)}\n.x{position:relative}\n.h{background:var(--red)!important}\n.h svg{width:66px}\n.hand{position:absolute;right:40px;top:1210px;font:700 44px 'Caveat';color:var(--black);transform:rotate(6deg)}\n</style></head><body>\n\n<div class=\"card\"><div class=\"ph\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/product-photos/sweet-cup-1.png\"><div class=\"badge\">Nieuw profiel</div></div>\n<div class=\"in\"><h1 data-slot=\"titel\" data-label=\"Naam\" data-max=\"22\">Sweet Cup <span>· €24,95</span></h1>\n<div class=\"loc\">Loveke · gemaakt op bestelling · gratis verzending</div>\n<div class=\"tags\"><b>wit</b><b>zilveren rand</b><b>\"loveke\" in handschrift</b></div>\n<div class=\"q\">Zoekt</div><div class=\"a\">Iemand die 's ochtends eerst koffie zet. Liefst met z'n twee: vanaf 2 stuks −7% met Loveke for Two.</div></div></div>\n<div class=\"btns\"><div class=\"x\"></div><div class=\"h\"><svg viewBox=\"0 0 24 22\"><path d=\"M12 21s-9-5.6-9-12A5 5 0 0 1 12 6a5 5 0 0 1 9 3c0 6.4-9 12-9 12z\" fill=\"#fff\"/></svg></div></div>\n</body></html>\n"}