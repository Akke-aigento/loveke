{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Loveke for Two</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n\n</head>\n<body>\n<div class=\"dots\" style=\"width: 1080px; height: 1350px; box-sizing: border-box; background-color: #FF7033; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 90px; gap: 34px; font-family: 'DM Sans', sans-serif; color: #1A1A1A; text-align: center\">\n<div style=\"display: flex; gap: 0\">\n<svg aria-hidden=\"true\" width=\"230\" height=\"230\" viewBox=\"0 0 24 24\" style=\"transform: rotate(-12deg)\"><path d=\"M12 21s-7.5-4.6-9.5-9.2C1 8.2 3.4 5 6.7 5c2 0 3.6 1.1 4.3 2.6h2C13.7 6.1 15.3 5 17.3 5 20.6 5 23 8.2 21.5 11.8 19.5 16.4 12 21 12 21z\" fill=\"#FFF8F0\" stroke=\"#1A1A1A\" stroke-width=\"1.2\"></path></svg>\n<svg aria-hidden=\"true\" width=\"230\" height=\"230\" viewBox=\"0 0 24 24\" style=\"transform: rotate(12deg); margin-left: -70px\"><path d=\"M12 21s-7.5-4.6-9.5-9.2C1 8.2 3.4 5 6.7 5c2 0 3.6 1.1 4.3 2.6h2C13.7 6.1 15.3 5 17.3 5 20.6 5 23 8.2 21.5 11.8 19.5 16.4 12 21 12 21z\" fill=\"#E3404B\" stroke=\"#1A1A1A\" stroke-width=\"1.2\"></path></svg>\n</div>\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 120px; line-height: 0.9; color: #FFF8F0; text-shadow: 8px 8px 0 #1A1A1A\">Loveke<br>for Two</div>\n<div style=\"background: #FFD43D; font-family: 'Lilita One', sans-serif; font-size: 150px; line-height: 1; padding: 20px 56px; border: 6px solid #1A1A1A; border-radius: 34px; box-shadow: 12px 12px 0 #1A1A1A; transform: rotate(-3deg)\" data-slot=\"korting\" data-label=\"Korting\" data-max=\"11\">-7%</div>\n<div style=\"font-size: 46px; font-weight: 700; line-height: 1.3; max-width: 820px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"74\">Koop er 2, de korting staat automatisch in je mandje.</div>\n<div style=\"font-family: 'Caveat', cursive; font-weight: 700; font-size: 62px; line-height: 1; color: #FFF8F0\" data-slot=\"handschrift\" data-label=\"Handgeschreven regel\" data-max=\"45\">één voor jou, één voor je Loveke</div>\n<div style=\"font-s