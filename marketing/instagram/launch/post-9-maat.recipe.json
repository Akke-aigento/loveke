{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>Maattip van Akke</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n\n</head>\n<body>\n<div style=\"width: 1080px; height: 1350px; box-sizing: border-box; background: #FFD43D; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; padding: 90px; gap: 44px; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div style=\"background: #1A1A1A; color: #FFF8F0; font-family: 'Lilita One', sans-serif; font-size: 40px; letter-spacing: 2px; padding: 14px 32px; border-radius: 999px; align-self: flex-start; transform: rotate(-3deg)\" data-slot=\"label\" data-label=\"Label\" data-max=\"15\">MAATTIP</div>\n<div style=\"background: #FFF8F0; border: 6px solid #1A1A1A; border-radius: 40px; box-shadow: 14px 14px 0 #1A1A1A; padding: 70px 64px; display: flex; flex-direction: column; gap: 30px\">\n<div style=\"font-family: 'Caveat', cursive; font-weight: 700; font-size: 86px; line-height: 1.02\" data-slot=\"citaat\" data-label=\"Citaat\" data-max=\"81\">\"Ik ben 1m83. Ik draag L voor normaal, XL voor oversized.\"</div>\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 46px; color: #FF7033\">Akke</div>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px\">\n<div style=\"background: #FFF8F0; border: 5px solid #1A1A1A; border-radius: 26px; padding: 30px; display: flex; flex-direction: column; gap: 6px\">\n<div style=\"font-size: 30px; font-weight: 600; color: #3D3D3D\">Normale fit</div>\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 110px; line-height: 1\">L</div>\n</div>\n<div style=\"background: #FF7033; color: #FFFFFF; border: 5px solid #1A1A1A; border-radius: 26px; padding: 30px; display: flex; flex-direction: column; gap: 6px\">\n<div style=\"font-size: 30px; font-weight: 600\">Oversized</div>\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 110px; line-height: 1\">XL</div>\n</div>\n</div>\n<div style=\"font-size: 36px; font-weight: 600\" data-slot=\"onderregel\" data-label=\"Onderregel\" data-max=\"56\">Alle maten per model: loveke.be/maatgids</div>\n</div>\n</body>\n</html>\n"}