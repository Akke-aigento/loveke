{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"loveke-size\" content=\"1080x1350\">\n<title>25 minuten</title>\n<style>/* Loveke Instagram-huisstijl. Lettertypes lokaal (fontsource), geen netwerk nodig. */\n@font-face{font-family:'Lilita One';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/lilita-one-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-400-normal.woff2\") format('woff2');font-weight:400}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'DM Sans';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/dm-sans-latin-700-normal.woff2\") format('woff2');font-weight:700}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-600-normal.woff2\") format('woff2');font-weight:600}\n@font-face{font-family:'Caveat';src:url(\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/marketing/instagram/fonts/caveat-latin-700-normal.woff2\") format('woff2');font-weight:700}\n:root{--cream:#FFF8F0;--black:#1A1A1A;--orange:#FF7033;--yellow:#FFD43D;--red:#E3404B;--pink:#FF85A1}\nhtml,body{margin:0;padding:0}\n.wm{background:linear-gradient(135deg,#E3404B 0%,#FF7033 55%,#FFC93D 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dots{background-image:radial-gradient(circle,rgba(26,26,26,.10) 2.5px,transparent 2.5px);background-size:22px 22px}\n/* Plek voor een Instagram-sticker (poll, link, vraag, aftelling): leeg in de export. */\n.slot{visibility:hidden}\n</style>\n\n</head>\n<body>\n<div style=\"width: 1080px; height: 1350px; box-sizing: border-box; background: #FF85A1; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; padding: 70px 80px 0; gap: 18px; font-family: 'DM Sans', sans-serif; color: #1A1A1A\">\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 210px; line-height: 0.85; color: #FFF8F0; -webkit-text-stroke: 6px #1A1A1A; text-shadow: 10px 10px 0 #1A1A1A\" data-slot=\"getal\" data-label=\"Getal\" data-max=\"10\">25</div>\n<div style=\"font-family: 'Lilita One', sans-serif; font-size: 70px; line-height: 1; text-align: center\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"38\">minuten vast op het toilet.</div>\n<div style=\"font-family: 'Caveat', cursive; font-weight: 700; font-size: 52px; line-height: 1\" data-slot=\"onderregel\" data-label=\"Onderregel\" data-max=\"36\">zo begon onze eerste avond</div>\n<div style=\"margin-top: 22px; width: 720px; height: 964px; border: 6px solid #1A1A1A; border-radius: 18px; box-shadow: 14px 14px 0 #1A1A1A; overflow: hidden; background: #FFFFFF; transform: rotate(1.5deg)\">\n<img src=\"https://raw.githubusercontent.com/Akke-aigento/loveke/main/src/assets/comic/strip-5.webp\" alt=\"Strippagina: Akke wacht met een pintje, Nastya zit vast in de badkamer van het hostel en ze lachen erom\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: top; display: block\">\n</div>\n</div>\n</body>\n</html>\n"}